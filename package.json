{
  "name": "crew",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Crew：你的本地 Agent 工作台",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --no-warnings --test \"tests/**/*.test.ts\"",
    "test:lead": "python3 scripts/lead/run_tests.py",
    "typecheck": "tsc --noEmit",
    "corpus": "node --no-warnings src/cli.ts",
    "mac-app": "bash scripts/make-mac-app.sh",
    "record:terminal": "vhs demo/terminal.tape",
    "record:window": "node --no-warnings demo/window.ts",
    "record:explainer": "node --no-warnings demo/explainer.ts",
    "record": "npm run record:terminal && npm run record:window",
    "diagram": "bash scripts/render-diagram.sh",
    "crew": "node --no-warnings src/cli.ts",
    "postinstall": "node scripts/prepare-pty.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.0"
  },
  "bin": {
    "corpus": "bin/corpus",
    "crew": "bin/crew"
  }
}
