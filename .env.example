# 复制为 .env 后填写。.env 不会提交。
DEEPSEEK_API_KEY=
# 整理证据用的模型，固定版本。claude- 开头（如 claude-sonnet-5-5）用本机已登录的 Claude 订阅，不用填 DEEPSEEK_API_KEY
CORPUS_MODEL=deepseek-flash
# 数据库位置，默认 ~/.working-corpus/corpus.db
# CORPUS_DB=~/.working-corpus/corpus.db
# 录讲解视频的配音才需要（npm run record:explainer），平时用不到
# ELEVENLABS_API_KEY=
