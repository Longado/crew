#!/usr/bin/env bash
# Crew 与 corpus 共用本地数据和启动逻辑。
set -euo pipefail
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  BASE="$(cd -P "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  case "$SELF" in /*) ;; *) SELF="$BASE/$SELF" ;; esac
done
exec "$(cd "$(dirname "$SELF")" && pwd)/corpus" "$@"
